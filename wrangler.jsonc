{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "proeditsapk",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/admin/api/*", "/articles/*"]
  }
}
