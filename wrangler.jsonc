{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "proeditsapk",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin/api/*",
      "/api/*",
      "/articles/*",
      "/article",
      "/article.html"
    ]
  },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  }
}
