{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "proeditsapk",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin/api/*",
      "/api/*",
      "/articles/*",
      "/article",
      "/article.html",
      "/media/icons/*",
      "/media/library/*",
      "/sitemap.xml",
      "/posts.json"
    ]
  },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proeditsapk-db",
      "database_id": "b4a03583-f791-41b8-97a5-534eedfd00f9",
      "migrations_dir": "migrations"
    }
  ]
}
